---
import { Image } from 'astro:assets';

import ExperienceYears from '@/components/ExperienceYears.astro';
import LimitedList from '@/components/LimitedList.astro';
import MysticCoffee from '@/components/MysticCoffee';
import ProjectShowcase from '@/components/ProjectShowcase.astro';
import RecommendationCarousel from '@/components/RecommendationCarousel.astro';
import ScrollEnhancements from '@/components/ScrollEnhancements.astro';
import SectionNavigator from '@/components/SectionNavigator.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import jeanHero from '@/assets/images/jean-hero.jpg';
import jeanTrilha from '@/assets/images/jean-trilha.jpg';
import { courses } from '@/data/courses';
import {
  events,
  higherEducation,
  technicalBooks,
  workshops,
} from '@/data/formation';
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/home.css';

const title = 'Jean Sousa Liz | Software Developer';
const description =
  'Portfólio profissional de Jean Sousa Liz, Software Developer';
const completedCourses = courses.filter(
  (course) => course.status === 'completed',
);
const inProgressCourses = courses.filter(
  (course) => course.status === 'in-progress',
);
---

<BaseLayout title={title} description={description}>
  <SiteHeader />

  <main id="conteudo">
    <section class="hero" id="inicio" aria-labelledby="hero-title">
      <div class="hero__grid container">
        <div class="hero__content" data-reveal>
          <p class="hero__identity">
            Software Developer · <ExperienceYears />
          </p>
          <h1 id="hero-title">Código simples de entender, manter e evoluir.</h1>
          <p class="hero__intro">
            Olá, sou o Jean. Minha especialidade é Delphi, mas meu trabalho
            nunca ficou preso a uma única stack. Desenvolvendo software desde
            2010, transformo desafios técnicos em soluções estáveis,
            performáticas e fáceis de manter.
          </p>
          <div class="hero__actions">
            <a class="button button--primary" href="#trajetoria"
              >Conheça minha trajetória</a
            >
            <a class="button button--secondary" href="#projetos"
              >Conhecer projetos</a
            >
            <a class="button button--secondary" href="#contato"
              >Entrar em contato</a
            >
          </div>
        </div>

        <div class="hero__portrait" data-reveal>
          <Image
            class="hero__portrait-image"
            src={jeanHero}
            alt="Jean Sousa Liz sorrindo em um ambiente profissional"
            format="webp"
            quality={85}
            width={576}
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    </section>

    <section
      class="section"
      data-navigation-section="competencias"
      aria-labelledby="competencias-title"
    >
      <div class="container">
        <SectionHeading
          number="01"
          anchorId="competencias"
          headingId="competencias-title"
          title="Competências"
          intro="Lista das principais competências técnicas e ferramentas utilizadas."
        />

        <div class="section__content">
          <div class="expertise-groups" data-reveal>
            <details class="expertise-group">
              <summary>
                <span>01</span><h3>Delphi</h3>
                <p>VCL · FireDAC · dbExpress · RTTI</p>
              </summary>
              <p>
                DUnit, DUnitX, Mocks, Profiling, Componentes, Packages, DLLs,
                Generics, TThread, ACBR, THorse entre outros.
              </p>
            </details>
            <details class="expertise-group">
              <summary>
                <span>04</span><h3>Outras stacks</h3>
                <p>Python · NET/C# · React · Java</p>
              </summary>
              <p>
                Experiências pontuais em diferentes linguagens e frameworks.
              </p>
            </details>
            <details class="expertise-group">
              <summary>
                <span>06</span><h3>Inteligência artificial</h3>
                <p>Planejar · Produzir · Validar · Documentar</p>
              </summary>
              <p>
                IA no planejamento e produção de código. Trabalho dividido em
                etapas e validado a cada entrega, com testes e documentação.
              </p>
            </details>
            <details class="expertise-group">
              <summary>
                <span>02</span><h3>Dados e performance</h3>
                <p>PostgreSQL · Oracle · Firebird · MongoDB</p>
              </summary>
              <p>
                SQL, procedures, triggers, transações, migração, transformação e
                processamento de grandes volumes de dados.
              </p>
            </details>
            <details class="expertise-group">
              <summary>
                <span>03</span><h3>Integrações e mensageria</h3>
                <p>REST · JSON · XML · SOAP · AMQP</p>
              </summary>
              <p>RabbitMQ, LDAP, certificados e assinatura digital.</p>
            </details>
            <details class="expertise-group">
              <summary>
                <span>05</span><h3>Ferramentas complementares</h3>
                <p>Git · GitHub Actions · Jira · RTC</p>
              </summary>
              <p>
                Pipelines, Docker, geração automatizada de versões, controle de
                cobertura, monitoramento e observabilidade.
              </p>
            </details>
          </div>
        </div>

        <header class="work-principles__heading" data-reveal>
          <h3>Como aplico esse conhecimento</h3>
        </header>

        <div class="work-principles" data-reveal>
          <article>
            <span>Requisitos e Diagnóstico</span>
            <h3>Contexto antes do código</h3>
            <p>
              Busco evidências, converso com as pessoas envolvidas e separo o
              que é urgente do que exige uma solução definitiva.
            </p>
          </article>
          <article>
            <span>Engenharia</span>
            <h3>Código confiável</h3>
            <p>
              Responsabilidades claras, princípios SOLID, Clean Code, Design
              Patterns e uma estrutura que favoreça leitura, manutenção e testes
              isolados.
            </p>
          </article>
          <article>
            <span>Entrega</span>
            <h3>Qualidade com pragmatismo</h3>
            <p>
              Prazo e qualidade são equilibrados pelo valor entregue, com
              débitos técnicos conscientes e seus efeitos conhecidos.
            </p>
          </article>
        </div>
      </div>
    </section>

    <section
      class="section trajectory"
      data-navigation-section="trajetoria"
      aria-labelledby="trajetoria-title"
    >
      <div class="container">
        <SectionHeading
          number="02"
          anchorId="trajetoria"
          headingId="trajetoria-title"
          title="Trajetória"
          intro="Dois ciclos profissionais com responsabilidades diferentes. Nos detalhes estão algumas das minhas principais atribuições e entregas."
          light
        />

        <div class="section__content">
          <div class="timeline" data-reveal>
            <details class="timeline__item" name="career-period">
              <summary>
                <span class="timeline__period"
                  >Janeiro de 2010 — janeiro de 2021</span
                >
                <h3>ASP Softwares</h3>
                <p>
                  Onde construí minha base profissional acompanhando código,
                  produto e a realidade de quem utilizava o sistema.
                </p>
                <span class="timeline__toggle" aria-hidden="true">
                  <span class="timeline__toggle-open">Ver detalhes</span>
                  <span class="timeline__toggle-close">Ocultar detalhes</span>
                </span>
              </summary>

              <div class="career-details">
                <section class="career-role">
                  <h4>Atuação no período</h4>
                  <ul>
                    <li>
                      Desenvolvimento de sistemas fiscais, comerciais,
                      industriais e de gestão de pessoas.
                    </li>
                    <li>
                      Requisitos, implantação e suporte junto aos clientes.
                    </li>
                    <li>Correções, performance e evolução de código legado.</li>
                  </ul>
                </section>

                <p class="career-selection-label">Entregas que destaco</p>

                <section class="career-context">
                  <h4>Domínio fiscal</h4>
                  <p>
                    Trabalhei com emissão de cupom fiscal, NF-e e SPED Fiscal,
                    além de soluções comerciais, industriais e de gestão de
                    pessoas.
                  </p>
                  <div class="career-evidence">
                    <p>
                      <strong>4 homologações do PAF-ECF</strong>
                      Implementação de requisitos, preparação do sistema, acompanhamento
                      dos testes e correção de inconformidades.
                    </p>
                    <p>
                      <strong>Módulo compartilhado de NF-e</strong>
                      Solução reutilizada por diferentes sistemas da empresa.
                    </p>
                  </div>
                </section>
              </div>
            </details>

            <details class="timeline__item" name="career-period">
              <summary>
                <span class="timeline__period"
                  >Fevereiro de 2021 — abril de 2026</span
                >
                <h3>Softplan</h3>
                <p>
                  Uma fase marcada por engenharia estruturada, sistemas de
                  grande porte, integrações judiciais e entregas automatizadas.
                </p>
                <span class="timeline__toggle" aria-hidden="true">
                  <span class="timeline__toggle-open">Ver detalhes</span>
                  <span class="timeline__toggle-close">Ocultar detalhes</span>
                </span>
              </summary>

              <div class="career-details">
                <section class="career-role">
                  <h4>Atuação no período</h4>
                  <ul>
                    <li>
                      Evolução de sistemas para processos judiciais e
                      extrajudiciais.
                    </li>
                    <li>Integrações REST, Web Services e serviços externos.</li>
                    <li>Diagnóstico de produção, revisão e arquitetura.</li>
                    <li>Referência técnica e onboarding de desenvolvedores.</li>
                    <li>CI/CD, automação, documentação e repasses técnicos.</li>
                  </ul>
                </section>

                <p class="career-selection-label">Entregas que destaco</p>

                <section class="career-context career-context--featured">
                  <h4>Domicílio Judicial Eletrônico</h4>
                  <p>
                    Implementei a nova integração mantendo compatibilidade com o
                    modelo MNI. Reaproveitei um componente de comunicação com
                    APIs, adaptei os contratos e utilizei a integração anterior
                    para enriquecer dados ausentes na nova resposta.
                  </p>
                  <div class="career-deadlines">
                    <p><strong>20 dias</strong> pronta para testes</p>
                    <p><strong>30 dias</strong> primeira versão gerada</p>
                  </div>
                </section>

                <section class="career-context">
                  <h4>Performance e automação</h4>
                  <div class="career-evidence">
                    <p>
                      <strong>2 dias → 1 hora</strong>
                      Importação de tabelas do CNJ em estados com muitos foros.
                    </p>
                    <p>
                      <strong>45 → 22 minutos</strong>
                      Redução no processamento completo de um pipeline de integração
                      contínua.
                    </p>
                  </div>
                </section>

                <section class="career-context">
                  <h4>Além da stack principal</h4>
                  <ol class="career-stack-list">
                    <li>
                      <strong>Python:</strong> ajuste em uma aplicação de pipeline
                      responsável por medir cobertura de testes.
                    </li>
                    <li>
                      <strong>.NET/C#:</strong> correção de uma consulta que sobrecarregava
                      o banco de dados.
                    </li>
                    <li><strong>React:</strong> evoluções de interface.</li>
                    <li>
                      <strong>Java:</strong> correção de autenticação LDAP.
                    </li>
                  </ol>
                </section>
              </div>
            </details>
          </div>
        </div>
      </div>
    </section>

    <section
      class="section"
      data-navigation-section="projetos"
      aria-labelledby="projetos-title"
    >
      <div class="container">
        <SectionHeading
          number="03"
          anchorId="projetos"
          headingId="projetos-title"
          title="Projetos"
          intro="Abaixo alguns projetos que mantenho em meu repositório pessoal:"
        />

        <div class="section__content">
          <ProjectShowcase />
        </div>
      </div>
    </section>

    <section
      class="section mystic-section"
      id="mystic-coffee"
      aria-labelledby="mystic-coffee-title"
    >
      <MysticCoffee client:visible />
    </section>

    <section
      class="section"
      data-navigation-section="formacao"
      aria-labelledby="formacao-title"
    >
      <div class="container">
        <SectionHeading
          number="04"
          anchorId="formacao"
          headingId="formacao-title"
          title="Formação"
        />

        <div class="section__content formation-content">
          <div class="formation-columns" data-reveal>
            <section class="courses-group">
              <header class="courses-group__heading">
                <p>Cursos superiores</p>
              </header>
              <ol class="courses-list formation-list">
                {
                  higherEducation.map((education, index) => (
                    <li class="course-row">
                      <span class="course-row__index">
                        {String(index + 1).padStart(2, '0')}
                      </span>
                      <div class="course-row__content course-row__content--illustrated">
                        <Image
                          class="course-row__institution-logo"
                          data-institution={education.institution.toLowerCase()}
                          src={education.icon}
                          alt={education.iconAlt}
                          loading="lazy"
                        />
                        <div>
                          <h4>{education.title}</h4>
                          <div class="course-row__meta">
                            <span>{education.institution}</span>
                            <time>{education.period}</time>
                          </div>
                        </div>
                      </div>
                    </li>
                  ))
                }
              </ol>
            </section>
            <section class="formation-extra formation-extra--books">
              <header class="courses-group__heading">
                <p>Livros técnicos</p>
              </header>
              <div class="technical-books">
                {
                  technicalBooks.map((book) => (
                    <Image
                      src={book.cover}
                      alt={`Capa do livro ${book.title}`}
                      loading="lazy"
                    />
                  ))
                }
              </div>
            </section>
          </div>

          <div class="formation-columns formation-columns--courses" data-reveal>
            <section class="courses-group">
              <header class="courses-group__heading">
                <p>Cursos concluídos</p>
              </header>
              <LimitedList ariaLabel="Cursos concluídos">
                {
                  completedCourses.map((course) => (
                    <li class="course-row">
                      <span class="course-row__index">
                        {course.periodShort}
                      </span>
                      <div class="course-row__content course-row__content--illustrated">
                        <span class="course-row__icons">
                          {course.icons?.map((icon) => (
                            <Image
                              src={icon.src}
                              alt={icon.alt}
                              loading="lazy"
                            />
                          ))}
                        </span>
                        <div>
                          <p class="course-row__title">
                            <strong>{course.titleLead}</strong>{' '}
                            {course.titleDetail}
                          </p>
                        </div>
                      </div>
                    </li>
                  ))
                }
              </LimitedList>
            </section>

            <section class="courses-group courses-group--current">
              <header class="courses-group__heading">
                <p>Cursos em andamento</p>
              </header>
              {
                inProgressCourses.length > 0 ? (
                  <LimitedList ariaLabel="Cursos em andamento">
                    {inProgressCourses.map((course) => (
                      <li class="course-row course-row--without-index">
                        <div class="course-row__content course-row__content--illustrated">
                          <span class="course-row__icons">
                            {course.icons?.map((icon) => (
                              <Image
                                src={icon.src}
                                alt={icon.alt}
                                loading="lazy"
                              />
                            ))}
                          </span>
                          <div>
                            <p class="course-row__title">
                              <strong>{course.titleLead}</strong>{' '}
                              {course.titleDetail}
                            </p>
                          </div>
                        </div>
                      </li>
                    ))}
                  </LimitedList>
                ) : (
                  <p class="courses-empty">
                    Nenhum curso selecionado no momento.
                  </p>
                )
              }
            </section>

            <section class="formation-extra formation-extra--event">
              <header class="courses-group__heading">
                <p>Eventos</p>
              </header>
              <LimitedList ariaLabel="Participações no Proud Tech Summit">
                {
                  events.map((event) => (
                    <li class="course-row">
                      <span class="course-row__index">{event.period}</span>
                      <div class="course-row__content course-row__content--illustrated">
                        <Image
                          class="event-logo"
                          src={event.icon}
                          alt=""
                          loading="lazy"
                        />
                        <p class="course-row__title">
                          <strong>{event.titleLead}</strong> {event.titleDetail}
                        </p>
                      </div>
                    </li>
                  ))
                }
              </LimitedList>
            </section>

            <section class="formation-extra formation-extra--event">
              <header class="courses-group__heading">
                <p>Workshops</p>
              </header>
              <LimitedList ariaLabel="Workshops realizados">
                {
                  workshops.map((workshop) => (
                    <li class="course-row">
                      <span class="course-row__index">{workshop.period}</span>
                      <div class="course-row__content course-row__content--illustrated">
                        <Image
                          class="event-logo"
                          src={workshop.icon}
                          alt=""
                          loading="lazy"
                        />
                        <p class="course-row__title">
                          <strong>{workshop.titleLead}</strong>{' '}
                          {workshop.titleDetail}
                        </p>
                      </div>
                    </li>
                  ))
                }
              </LimitedList>
            </section>
          </div>
        </div>
      </div>
    </section>

    <section
      class="section about"
      data-navigation-section="sobre"
      aria-labelledby="sobre-title"
    >
      <div class="container">
        <SectionHeading
          number="05"
          anchorId="sobre"
          headingId="sobre-title"
          title="Sobre"
          light
        />

        <div class="about__grid section__content">
          <div class="about__prose" data-reveal>
            <p>
              Escolhi a tecnologia ainda na adolescência. Pouco depois de
              começar a faculdade de Ciência da Computação, um professor
              percebeu meu interesse e me convidou para trabalhar em sua
              empresa. Foi assim, de forma simples, que minha carreira começou.
            </p>
            <p>
              Desde 2010, vivi contextos bem diferentes: comecei próximo de
              clientes, produto e implantação e depois passei a trabalhar em
              equipes especializadas, com processos e automações bem definidos.
              Essa transição ampliou minha visão e me deu confiança para
              aprender a tecnologia que cada problema exigir.
            </p>
            <p>
              Sou calmo, analítico e detalhista. Gosto de código, ambientes e
              processos organizados, sem transformar qualidade em
              perfeccionismo. Também gosto de trabalhar em parceria,
              compartilhar conhecimento e ajudar outros desenvolvedores.
            </p>
            <p>
              Ver uma solução funcionando é uma satisfação. Perceber que ela
              facilitou o trabalho ou fez diferença na vida de alguém é o que
              realmente dá sentido ao que faço.
            </p>
          </div>

          <div class="about__media" data-reveal>
            <figure class="about__figure">
              <Image
                class="about__image"
                src={jeanTrilha}
                alt="Jean durante uma trilha em meio à mata em Santa Catarina"
                format="webp"
                quality={80}
                width={640}
                loading="lazy"
              />
              <figcaption class="about__caption">
                <h3>Além do código</h3>
                <p>
                  No tempo livre, gosto de ler, assistir a filmes e séries,
                  cozinhar, correr e fazer trilhas.
                </p>
              </figcaption>
            </figure>
          </div>
        </div>
      </div>
    </section>

    <section
      class="section"
      data-navigation-section="recomendacoes"
      aria-labelledby="recomendacoes-title"
    >
      <div class="container">
        <SectionHeading
          number="06"
          anchorId="recomendacoes"
          headingId="recomendacoes-title"
          title="Recomendações"
          intro="Feito por pessoas que acompanharam de perto minhas entregas. Disponível no LinkedIn."
        />

        <div class="section__content" data-reveal>
          <RecommendationCarousel />
        </div>
      </div>
    </section>

    <section
      class="section contact"
      data-navigation-section="contato"
      aria-labelledby="contato-title"
    >
      <div id="contato" class="container contact__content" data-reveal>
        <p class="contact__eyebrow">Contato</p>
        <h2 id="contato-title">
          <span class="contact__coffee" aria-hidden="true">
            <Image src="/coffee-cup.svg" alt="" width={60} height={60} />
          </span>
          Vamos tomar um café?
        </h2>
        <p>
          Se quiser trocar experiências ou conversar sobre desenvolvimento, me
          encontre no LinkedIn.
        </p>
        <div class="contact__actions">
          <a
            class="button button--primary"
            href="https://www.linkedin.com/in/jsousaliz/"
            target="_blank"
            rel="noreferrer"
          >
            <Image
              class="button__icon"
              src="/icons/social/linkedin.svg"
              alt=""
              width={20}
              height={20}
            />
            Conversar no LinkedIn
          </a>
          <a
            class="button button--secondary"
            href="https://github.com/jsousaliz"
            target="_blank"
            rel="noreferrer"
          >
            <Image
              class="button__icon"
              src="/icons/social/github.svg"
              alt=""
              width={20}
              height={20}
            />
            Explorar meu GitHub
          </a>
          <a
            class="button button--secondary"
            href="https://www.youtube.com/@jsousaliz"
            target="_blank"
            rel="noreferrer"
          >
            <Image
              class="button__icon"
              src="/icons/social/youtube.svg"
              alt=""
              width={20}
              height={20}
            />
            Canal no YouTube
          </a>
        </div>
        <p class="location">Santa Catarina, Brasil</p>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="site-footer__inner container">
      <span>Jean Sousa Liz · Software Developer</span>
      <span>Construído com Astro, React, TypeScript e CSS.</span>
    </div>
  </footer>

  <ScrollEnhancements />
  <SectionNavigator />

  <script>
    for (const timeline of document.querySelectorAll<HTMLElement>(
      '.timeline',
    )) {
      const entries = Array.from(
        timeline.querySelectorAll<HTMLDetailsElement>('.timeline__item'),
      );

      for (const entry of entries) {
        const summary = entry.querySelector<HTMLElement>(':scope > summary');
        if (!summary) continue;

        summary.addEventListener('click', (event) => {
          event.preventDefault();

          const willOpen = !entry.open;
          const positionBefore = entry.getBoundingClientRect().top;

          for (const otherEntry of entries) otherEntry.open = false;
          entry.open = willOpen;

          requestAnimationFrame(() => {
            const positionAfter = entry.getBoundingClientRect().top;
            window.scrollBy({
              top: positionAfter - positionBefore,
              behavior: 'instant',
            });
          });
        });
      }
    }
  </script>
</BaseLayout>
