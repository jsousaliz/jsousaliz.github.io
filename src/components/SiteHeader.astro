---
import ThemeToggle from './ThemeToggle.astro';

const navigation = [
  { href: '#especialidades', label: 'Especialidades' },
  { href: '#trajetoria', label: 'Trajetória' },
  { href: '#projetos', label: 'Projetos' },
  { href: '#formacao', label: 'Formação' },
  { href: '#sobre', label: 'Sobre' },
  { href: '#recomendacoes', label: 'Recomendações' },
  { href: '#contato', label: 'Contato' },
];
---

<header class="site-header" data-site-header>
  <div class="site-header__inner container">
    <a class="brand" href="#inicio" aria-label="Jean Sousa Liz — início">
      <span class="brand__mark" aria-hidden="true">JS</span>
      <span class="brand__name">Jean Sousa Liz</span>
    </a>

    <nav
      class="navigation"
      id="site-navigation"
      aria-label="Navegação principal"
      data-navigation
    >
      <ul>
        {
          navigation.map((item) => (
            <li>
              <a href={item.href} data-navigation-link>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="site-header__actions">
      <span
        class="language-preview"
        lang="pt-BR"
        aria-label="Idioma atual: português"
      >
        PT
      </span>
      <ThemeToggle />
      <button
        class="menu-toggle"
        type="button"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="site-navigation"
        data-menu-toggle
      >
        <span></span><span></span>
      </button>
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const navigation = document.querySelector<HTMLElement>('[data-navigation]');
  const menuToggle =
    document.querySelector<HTMLButtonElement>('[data-menu-toggle]');

  function closeMenu(): void {
    if (!header || !menuToggle) return;
    header.dataset.menuOpen = 'false';
    menuToggle.ariaExpanded = 'false';
    menuToggle.ariaLabel = 'Abrir menu';
  }

  menuToggle?.addEventListener('click', () => {
    if (!header) return;
    const willOpen = header.dataset.menuOpen !== 'true';
    header.dataset.menuOpen = String(willOpen);
    menuToggle.ariaExpanded = String(willOpen);
    menuToggle.ariaLabel = willOpen ? 'Fechar menu' : 'Abrir menu';
  });

  navigation?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 50;
    top: 0;
    right: 0;
    left: 0;
    border-bottom: 1px solid transparent;
    background: color-mix(in srgb, var(--color-background) 82%, transparent);
    backdrop-filter: blur(1rem);
    transition: border-color var(--duration-fast) var(--ease-standard);
  }

  .site-header__inner {
    display: flex;
    min-height: var(--header-height);
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .brand__mark {
    display: none;
  }

  .navigation ul {
    display: flex;
    margin: 0;
    padding: 0;
    align-items: center;
    gap: clamp(0.75rem, 1.5vw, 1.75rem);
    list-style: none;
  }

  .navigation a {
    position: relative;
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    font-weight: 600;
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .navigation a::after {
    position: absolute;
    right: 0;
    bottom: -0.45rem;
    left: 0;
    height: 2px;
    border-radius: 999px;
    background: var(--color-accent);
    content: '';
    opacity: 0;
    transform: scaleX(0.5);
    transition:
      opacity var(--duration-fast) var(--ease-standard),
      transform var(--duration-fast) var(--ease-standard);
  }

  .navigation a:hover,
  .navigation a[aria-current='location'] {
    color: var(--color-text);
  }

  .navigation a[aria-current='location']::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .language-preview {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface-translucent);
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 100%;
    height: 1px;
    margin-block: 0.25rem;
    background: var(--color-text);
    transition: transform var(--duration-fast) var(--ease-standard);
  }

  @media (max-width: 61.99rem) {
    .brand__name {
      display: none;
    }

    .brand__mark {
      display: inline-grid;
      width: 2.75rem;
      height: 2.75rem;
      border: 1px solid var(--color-border);
      border-radius: 50%;
      place-items: center;
    }

    .menu-toggle {
      display: block;
    }

    .navigation {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: var(--gutter);
      left: var(--gutter);
      padding: var(--space-5);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
      background: var(--color-surface);
      box-shadow: var(--shadow-lg);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-0.5rem);
      transition:
        opacity var(--duration-fast) var(--ease-standard),
        transform var(--duration-fast) var(--ease-standard);
    }

    .navigation ul {
      align-items: stretch;
      flex-direction: column;
      gap: 0;
    }

    .navigation a {
      display: block;
      padding-block: 0.75rem;
      font-size: var(--text-base);
    }

    .site-header[data-menu-open='true'] .navigation {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0);
    }

    .site-header[data-menu-open='true'] .menu-toggle span:first-child {
      transform: translateY(0.25rem) rotate(45deg);
    }

    .site-header[data-menu-open='true'] .menu-toggle span:last-child {
      transform: translateY(-0.25rem) rotate(-45deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navigation,
    .navigation a,
    .navigation a::after,
    .menu-toggle span {
      transition: none;
    }
  }
</style>
