---
interface Props {
  ariaLabel: string;
}

const { ariaLabel } = Astro.props;
---

<div
  class="courses-list--limited"
  data-limited-list
  role="region"
  aria-label={ariaLabel}
>
  <ol class="courses-list courses-list--compact">
    <slot />
  </ol>
</div>

<script>
  const visibleItems = 4;

  function updateLimitedLists(): void {
    document
      .querySelectorAll<HTMLElement>('[data-limited-list]')
      .forEach((region) => {
        const list = region.querySelector<HTMLOListElement>(':scope > ol');
        if (!list) return;

        const items = Array.from(list.children).filter(
          (item): item is HTMLElement => item instanceof HTMLElement,
        );
        const isOverflowing = items.length > visibleItems;

        region.classList.toggle('is-overflowing', isOverflowing);
        if (isOverflowing) region.tabIndex = 0;
        else region.removeAttribute('tabindex');

        if (!isOverflowing) {
          region.style.removeProperty('--limited-list-height');
          return;
        }

        const fourthItem = items[visibleItems - 1];
        if (!fourthItem) return;

        const listTop = region.getBoundingClientRect().top;
        const fourthItemBottom = fourthItem.getBoundingClientRect().bottom;
        const visibleHeight = Math.ceil(fourthItemBottom - listTop);
        region.style.setProperty('--limited-list-height', `${visibleHeight}px`);
      });
  }

  document.fonts.ready.then(updateLimitedLists);
  window.addEventListener('load', updateLimitedLists, { once: true });

  const resizeObserver = new ResizeObserver(updateLimitedLists);
  document
    .querySelectorAll('[data-limited-list]')
    .forEach((list) => resizeObserver.observe(list));
</script>
